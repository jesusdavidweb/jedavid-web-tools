# jedavid-web-tools MCP runtime environment
# Copy to `.env` and fill the values you need. NEVER commit `.env`.

# --- Cloudflare ----------------------------------------------------------
# A read-only API token with zone:read and account-level reads as needed.
# Create at https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=
# The account ID for account-scoped tools (Workers, Pages, D1, R2, KV, Queues, Access).
# CLOUDFLARE_ACCOUNT_ID=

# --- GitHub --------------------------------------------------------------
# Optional. Without it, public repos work but rate limits are tighter.
# GITHUB_TOKEN=

# --- WordPress -----------------------------------------------------------
# HTTPS base URL of the WordPress site (e.g. https://example.com).
# WORDPRESS_BASE_URL=
# Application-Password-capable user (create at Users → Profile → Application Passwords).
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# --- WooCommerce ---------------------------------------------------------
# HTTPS base URL of the WooCommerce store.
# WOOCOMMERCE_BASE_URL=
# WooCommerce REST API consumer key + secret (read-only recommended).
# WOOCOMMERCE_KEY=
# WOOCOMMERCE_SECRET=

# --- Tests (DO NOT set in production) ------------------------------------
# When set to 1, the runtime allows loopback (127.0.0.1) targets. Used by
# the test suite. Leave unset in production.
# JEDAVID_TEST_ALLOW_LOOPBACK=0
